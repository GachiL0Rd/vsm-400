set windows-shell := ["powershell.exe", "-NoLogo", "-NoProfile", "-Command"]

default:
    @just --list

# Install dependencies exactly from package-lock.json.
setup:
    npm ci --include=dev

# Run every non-mutating module check.
check:
    npm run verify

# Start the local development server.
dev:
    npm run dev

# Format supported files in place.
format:
    npm run format

# Build the deployable server + client distribution under dist/.
build:
    npm run build

# Start the compiled distribution created by `just build`.
start:
    npm run start:server

# Smoke-test the compiled distribution in isolation from sources/node_modules.
test-production:
    npm run test:production
