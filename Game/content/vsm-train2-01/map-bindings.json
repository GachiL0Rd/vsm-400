  "anchorSnapRule": "The anchor cell is the zone tile containing the Tiled point when that tile is walkable. Otherwise it is the nearest zone tile by Manhattan distance. Ties resolve to the larger y, then the smaller x, then a default-active region, then the smaller cell id. Seat cells are not snap targets. A tile index is floor(pixel / tileSize), including negative coordinates.",
  "doorLinkRule": "The train nose is not walkable, so each platform region gets one bidirectional edge from tile (-1, 8) to the boarding_door cell. Cost is Manhattan tile distance times movementCostPerTile. Edge ids end with :door.",
  "seatAccess": {
    "aisleY": 8,
    "zoneLayer": "WalkableZones",
    "seatLayer": "PassengerSeats",
    "anchorLayer": "InteractionAnchors",
    "solidLayer": "Collision",
    "solidType": "SeatSolid"
  },
  "regions": [
