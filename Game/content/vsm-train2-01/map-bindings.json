      "includeSeats": true,
      "cellIdPrefix": "carriage",
      "capacity": "carriage"
    },
    {
      "id": "platform-origin",
      "defaultActive": true,
      "publicVisualId": "map.train2-long.platform",
      "zones": ["origin_platform"],
      "includeSeats": false,
      "cellIdPrefix": "platform-origin",
      "capacity": "platform"
    },
    {
      "id": "platform-standard",
