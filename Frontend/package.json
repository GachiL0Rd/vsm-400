{
  "name": "vsm-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check:biome": "biome ci --error-on-warnings .",
    "check:write": "biome check --write .",
    "typecheck": "tsc -b",
    "verify": "npm run check:biome && npm run typecheck && npm run build",
    "api:types": "npx --yes openapi-typescript@7.13.0 http://127.0.0.1:3000/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
