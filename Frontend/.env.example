# Адрес игрового клиента для кнопки «Начать смену».
# Пусто или переменной нет — кнопка показывает «Игра недоступна» и не является ссылкой.
# Подставляется при запуске и сборке Vite. Смена значения для готового dist/ не действует.
VITE_GAME_URL=

# Базовый URL API в браузере. Пусто — тот же origin (в dev /api проксируется).
VITE_API_URL=

# Куда Vite проксирует /api в dev и preview. Не попадает в клиентский бандл.
# VITE_API_PROXY=http://127.0.0.1:3000
