# Скопируйте в deploy/.env на сервере и заполните. Файл .env не коммитится.
# Секреты: `openssl rand -hex 32` (SEED_ENC_KEY — ровно 64 hex-символа).

DOMAIN=wibblywobbly.ru
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
GAME_TICKET_SECRET=
# Общий секрет Backend ↔ Game Server (Game получает его как PLATFORM_SERVICE_TOKEN).
GAME_SERVER_TOKEN=
SEED_ENC_KEY=
EXT_ID_PEPPER=

GAME_LEVEL_ID=vsm-train2-01
GAME_LOG_LEVEL=info
