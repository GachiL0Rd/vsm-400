# Только для локальной разработки. Не использовать эти значения вне своей машины.

NODE_ENV=development
PORT=3000
# Проброс docker compose на хост. Внутри сети сервисы слушают 5432 и 6379.
# Занятый 5432: POSTGRES_PORT=5433 и тот же порт в DATABASE_URL.
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://vsm:vsm@127.0.0.1:5432/vsm
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=local-dev-jwt-access-secret-32chars
GAME_TICKET_SECRET=local-dev-game-ticket-secret-32ch
GAME_SERVER_TOKEN=local-dev-game-server-token
SEED_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EXT_ID_PEPPER=local-dev-ext-id-pepper
CORS_ORIGINS=http://127.0.0.1:5173
PUBLIC_GAME_WS_URL=ws://127.0.0.1:3001/game
# В NODE_ENV=production процесс не стартует, пока здесь не true.
COOKIE_SECURE=false
# Пусто, false или 0 — адрес сокета, X-Forwarded-For не читается.
# Иначе IP, CIDR или loopback/linklocal/uniquelocal через запятую.
# true и число хопов запрещены.
TRUST_PROXY=
# Пусто — любой публичный https-хост. Иначе hostname через запятую, частные адреса всё равно запрещены.
WEBHOOK_ALLOWED_HOSTS=
# none | openai-compatible | gigachat | yandex. none не пополняет пул.
# yandex — алиас openai-compatible: база https://ai.api.cloud.yandex.net/v1,
# модель gpt://<LLM_PROJECT>/<LLM_MODEL>/latest, заголовок x-data-logging-enabled: false.
LLM_PROVIDER=none
# origin без /v1. Для yandex можно не задавать.
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=
LLM_API_KEY=
# Folder Яндекса. Уходит заголовком OpenAI-Project. Для короткого LLM_MODEL обязателен.
LLM_PROJECT=
# llama-cpp | vllm | yandex. Пусто: yandex у провайдера yandex, иначе llama-cpp.
# llama-cpp шлёт repeat_penalty и выключает thinking. vllm и yandex эти поля не принимают.
LLM_PROFILE=
# JSON-объект доп. заголовков, например {"X-Title":"vsm"}.
LLM_EXTRA_HEADERS=
LLM_TIMEOUT_MS=90000
# GigaChat scope PERS очередь всё равно держит в 1 поток, иначе 429.
LLM_CONCURRENCY=2
# Пусто: gigachat и yandex 1.0, openai-compatible и none 0.7.
# GigaChat-2-Max: при 0.4 и 0.7 Jaccard 0.84, для пула берём 1.0.
# Alice Flash: при 0.4–0.7 ещё близко (0.74), при 1.0 пары 0.48 и 0.45. Потолок API Яндекса — 1.
# Qwen3-8B: 0.4 и 0.7 дали один текст, выше 0.7 смысл плывёт, поэтому 0.7.
LLM_TEMPERATURE=
LLM_TOP_P=0.8
LLM_TOP_K=20
# false | off — без второго вызова. Тогда autoApprove не срабатывает, статус PENDING_REVIEW.
# Пустые LLM_JUDGE_* повторяют генератор. Температура судьи всегда 0.
LLM_JUDGE=true
LLM_JUDGE_PROVIDER=
LLM_JUDGE_BASE_URL=
LLM_JUDGE_MODEL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_PROJECT=
LLM_JUDGE_PROFILE=
LLM_JUDGE_EXTRA_HEADERS=
# Уже Base64 (Client ID:Client Secret). Для gigachat обязателен вместе с CA и моделью.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_FILE=
# Chat: {база}/v1/chat/completions. Пусто = https://api.giga.chat. OAuth не здесь.
GIGACHAT_BASE_URL=https://api.giga.chat
